# ==============================================================================
# Dosya: .env (Ortam Değişkenleri Konfigürasyonu)
# Ne İşe Yarar: Projemizin içindeki gizli şifreleri, veritabanı portlarını ve 
# bağlantı linklerini kodun içine koymak yerine dışarıdan (bu dosyadan) okuruz.
# Mülakatlarda "Neden şifreleri koda yazmadın?" diye sorarlarsa, 
# "Güvenlik açığı yaratmamak için Environment Variable (.env) kullandım" diyeceksin.
# ==============================================================================

# API'mizin çalışacağı port
PORT=3000

# PostgreSQL Bağlantı Bilgileri (Az önce docker-compose'da belirlediğimiz şifre ve kullanıcı)
DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=password123
DB_NAME=autoresolve

# RabbitMQ (Mesaj Kuyruğu) Bağlantı Linki
RABBITMQ_URL=amqp://admin:password123@localhost:5672
